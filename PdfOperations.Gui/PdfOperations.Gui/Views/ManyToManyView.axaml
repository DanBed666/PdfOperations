<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.ManyToManyView"
             x:DataType="vm:ManyToManyViewModel">

    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Text="{Binding InputTitle}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding InputFile}" />
            <Button Grid.Column="1"
                    Content="Browse"
                    Click="BrowseInputFile_Click" />
        </Grid>

        <TextBlock Text="Output directory" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding OutputDirectory}" />
            <Button Grid.Column="1"
                    Content="Browse"
                    Click="BrowseOutputDirectory_Click" />
        </Grid>

        <TextBlock Text="Output file name" />
        <TextBox Text="{Binding OutputFileName}" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Start"
                    Command="{Binding StartPdfToTxtCommand}"
                    Width="120" />

            <Button Content="Open output folder"
                    Command="{Binding OpenOutputFolderCommand}"
                    Width="170" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>