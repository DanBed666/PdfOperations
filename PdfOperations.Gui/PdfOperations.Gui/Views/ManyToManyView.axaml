<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:views="using:PdfOperations.Gui.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.ManyToManyView"
             x:DataType="vm:ManyToManyViewModel">

    <Grid RowDefinitions="Auto,*">
        <views:StatusBannerView Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding InputTitle}" />

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="Browse"
                                Click="BrowseInputFile_Click" />
                        <Button Content="Add"
                                Click="AddInputFiles_Click" />
                    </StackPanel>

                    <views:FileListView DataContext="{Binding InputFilesList}" />
                </StackPanel>

                <TextBlock Text="Output directory" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="1"
                            Content="Browse"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <TextBlock Text="Output file name" />
                <TextBox Text="{Binding OutputFileName}"
                         IsEnabled="{Binding CanEditOutputFileName}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"
                            Width="120" />

                    <Button Content="Open output folder"
                            Command="{Binding OpenOutputFolderCommand}"
                            Width="170" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
