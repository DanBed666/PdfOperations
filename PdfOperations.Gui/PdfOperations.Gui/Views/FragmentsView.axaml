<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             xmlns:views="clr-namespace:PdfOperations.Gui.Views"
             x:Class="PdfOperations.Gui.Views.FragmentsView"
             x:DataType="vm:FragmentsViewModel">

    <Grid RowDefinitions="Auto,*">
        <views:StatusBannerView Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12"
                        IsEnabled="{Binding IsNotBusy}">
                <TextBlock Text="{Binding Loc.BuildPdfFromFragments}"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding Loc.FragmentPdfFile}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedFragmentFilesText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"
                             MaxHeight="140"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Column="1"
                            Content="{Binding Loc.Browse}"
                            Click="BrowseFragmentFile_Click" />
                </Grid>
                
                <ScrollViewer MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding SelectedFragmentFilesInfo}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <TextBlock Text="{Binding Loc.Pages}" />
                <TextBox Text="{Binding PageNumbers}"
                         PlaceholderText="{Binding Loc.ExamplePages}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="{Binding Loc.AddFragment}"
                            Command="{Binding AddFragmentCommand}"
                            MinWidth="130" />

                    <Button Content="{Binding Loc.MoveUp}"
                            Command="{Binding MoveFragmentUpCommand}"
                            Width="110" />

                    <Button Content="{Binding Loc.MoveDown}"
                            Command="{Binding MoveFragmentDownCommand}"
                            Width="120" />

                    <Button Content="{Binding Loc.RemoveSelected}"
                            Command="{Binding RemoveFragmentCommand}"
                            Width="150" />

                    <Button Content="{Binding Loc.Clear}"
                            Command="{Binding ClearFragmentsCommand}"
                            Width="90" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.Fragments}" />
                <ListBox ItemsSource="{Binding Fragments}"
                         SelectedItem="{Binding SelectedFragment}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource InputListBackgroundBrush}"
                         BorderBrush="{DynamicResource ListBorderBrush}"
                         MinHeight="120"
                         MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayText}"
                                           Foreground="{DynamicResource InputListTextBrush}"
                                           TextWrapping="Wrap"
                                           ToolTip.Tip="{Binding DisplayPath}" />
                                <TextBlock Text="{Binding PageNumbers}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding Loc.OutputDirectory}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="1"
                            Content="{Binding Loc.Browse}"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <CheckBox Content="{Binding Loc.OverwriteExistingFiles}"
                          IsChecked="{Binding OverwriteExistingFiles}" />

                <TextBlock Text="{Binding Loc.OutputFileName}" />
                <TextBox Text="{Binding OutputFileName}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="{Binding Loc.Start}"
                            Classes="primary"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Width="120" />

                    <Button Content="{Binding Loc.OpenOutputFolder}"
                            Command="{Binding OpenOutputFolderCommand}"
                            MinWidth="170" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
