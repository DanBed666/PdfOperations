<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.FragmentsView"
             x:DataType="vm:FragmentsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12">
            <TextBlock Text="Build PDF from fragments"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Text="Fragment PDF file" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding SelectedFragmentFile}"
                         IsReadOnly="True"
                         TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseFragmentFile_Click" />
            </Grid>
            
            <TextBlock Text="{Binding SelectedFragmentFileInfo}"
                       Foreground="#666666"
                       TextWrapping="Wrap" />

            <TextBlock Text="Pages" />
            <TextBox Text="{Binding PageNumbers}"
                     Watermark="Example: 1,3-5" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Add fragment"
                        Command="{Binding AddFragmentCommand}"
                        Width="130" />

                <Button Content="Remove selected"
                        Command="{Binding RemoveFragmentCommand}"
                        Width="150" />
            </StackPanel>

            <TextBlock Text="Fragments" />
            <ListBox ItemsSource="{Binding Fragments}"
                     SelectedItem="{Binding SelectedFragment}"
                     MinHeight="120"
                     MaxHeight="220">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" />
                            <TextBlock Text="{Binding PageNumbers}"
                                       Foreground="#666666" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Output directory" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding OutputDirectory}" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseOutputDirectory_Click" />
            </Grid>

            <TextBlock Text="Output file name" />
            <TextBox Text="{Binding OutputFileName}" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Start"
                        Command="{Binding StartCommand}"
                        Width="120" />

                <Button Content="Open output folder"
                        Command="{Binding OpenOutputFolderCommand}"
                        Width="170" />
            </StackPanel>

            <Border Background="#F3F4F6"
                    Padding="10"
                    Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>