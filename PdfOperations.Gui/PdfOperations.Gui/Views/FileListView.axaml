<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.FileListView"
             x:DataType="vm:FileListViewModel">

    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
          RowSpacing="6" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}: {1}">
                    <Binding Path="Loc.SelectedFilesLabel" />
                    <Binding Path="FilesSummary" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Files}"
                 SelectedItem="{Binding SelectedFile}"
                 SelectedItems="{Binding SelectedFiles}"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource InputListBackgroundBrush}"
                 BorderBrush="{DynamicResource ListBorderBrush}"
                 MinHeight="80"
                 MaxHeight="180">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{DynamicResource InputListTextBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding DisplayPath}" />

                        <TextBlock Text="{Binding DirectoryPath}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="PathSegmentEllipsis"
                                   ToolTip.Tip="{Binding DisplayPath}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="1"
                    Spacing="8"
                    VerticalAlignment="Top">
            <Button Content="{Binding Loc.MoveUp}"
                    Width="90"
                    IsVisible="{Binding ShowMoveButtons}"
                    Command="{Binding MoveSelectedUpCommand}" />
            <Button Content="{Binding Loc.MoveDown}"
                    Width="90"
                    IsVisible="{Binding ShowMoveButtons}"
                    Command="{Binding MoveSelectedDownCommand}" />
            <Button Content="{Binding Loc.Remove}"
                    Width="90"
                    Command="{Binding RemoveSelectedFileCommand}" />
            <Button Content="{Binding Loc.Clear}"
                    Width="90"
                    Command="{Binding ClearFilesCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
