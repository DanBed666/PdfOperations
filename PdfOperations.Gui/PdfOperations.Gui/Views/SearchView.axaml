<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Text="Input files" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding InputFilesText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70"
                         MaxHeight="140"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseInputFiles_Click" />
            </Grid>

            <TextBlock Text="Search phrase" />
            <TextBox Text="{Binding Phrase}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Lines before" />
                    <NumericUpDown Value="{Binding Before}"
                                   Minimum="0"
                                   Maximum="20" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Lines after" />
                    <NumericUpDown Value="{Binding After}"
                                   Minimum="0"
                                   Maximum="20" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Output directory" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding OutputDirectory}" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseOutputDirectory_Click" />
            </Grid>

            <TextBlock Text="Report file name" />
            <TextBox Text="{Binding OutputFileName}" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Start"
                        Command="{Binding StartCommand}"
                        Width="120" />

                <Button Content="Open output folder"
                        Command="{Binding OpenOutputFolderCommand}"
                        Width="170" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>