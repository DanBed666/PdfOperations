<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             xmlns:views="clr-namespace:PdfOperations.Gui.Views"
             x:Class="PdfOperations.Gui.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Grid RowDefinitions="Auto,*">
        <views:StatusBannerView Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12"
                        Margin="0,0,20,8"
                        IsEnabled="{Binding IsNotBusy}">
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding InputTitle}" />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="{Binding Loc.SelectFilesButton}"
                                Click="BrowseInputFiles_Click" />
                        <Button Content="{Binding Loc.AddFilesButton}"
                                IsEnabled="{Binding InputFilesList.HasFiles}"
                                Click="AddInputFiles_Click" />
                    </StackPanel>

                    <views:FileListView DataContext="{Binding InputFilesList}" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.SearchPhrase}" />
                <TextBox Text="{Binding Phrase}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{Binding Loc.LinesBefore}" />
                        <NumericUpDown Value="{Binding Before}"
                                       FormatString="0"
                                       ParsingNumberStyle="Integer"
                                       Increment="1"
                                       Minimum="0"
                                       Maximum="20" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{Binding Loc.LinesAfter}" />
                        <NumericUpDown Value="{Binding After}"
                                       FormatString="0"
                                       ParsingNumberStyle="Integer"
                                       Increment="1"
                                       Minimum="0"
                                       Maximum="20" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Loc.OutputDirectory}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputDirectory}"
                             Classes="pathTooltip" />
                    <Button Grid.Column="1"
                            Content="{Binding Loc.Browse}"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <CheckBox Content="{Binding Loc.OverwriteExistingFiles}"
                          IsChecked="{Binding OverwriteExistingFiles}" />

                <TextBlock Text="{Binding Loc.ReportFileName}" />
                <TextBox Text="{Binding OutputFileName}" />

                <CheckBox Content="{Binding Loc.AlsoExportToExcel}"
                          IsChecked="{Binding ExportToExcel}" />
                
                <CheckBox Content="{Binding Loc.AlsoExportToJson}"
                          IsChecked="{Binding ExportToJson}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="{Binding Loc.Start}"
                            Classes="primary"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Width="120" />

                    <Button Content="{Binding Loc.OpenOutputFolder}"
                            Command="{Binding OpenOutputFolderCommand}"
                            MinWidth="170" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
