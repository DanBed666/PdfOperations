<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.HelpView"
             x:DataType="vm:HelpViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="Bold" />

            <TextBlock Text="{Binding HelpText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22" />
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding RequirementsTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RequirementsText}" TextWrapping="Wrap" LineHeight="22" />
                <HyperlinkButton NavigateUri="https://github.com/DanBed666/PdfOperations/releases/latest" HorizontalAlignment="Left">
                    <TextBlock Text="GitHub Releases" TextWrapping="Wrap" />
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
