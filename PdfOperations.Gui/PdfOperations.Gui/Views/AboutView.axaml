<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             xmlns:views="using:PdfOperations.Gui.Views"
             xmlns:models="using:PdfOperations.Gui.Models"
             x:Class="PdfOperations.Gui.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <UserControl.Styles>
        <Style Selector="Arc.updating">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="HyperlinkButton.projectLink">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="models:ProjectCredit" x:DataType="models:ProjectCredit">
            <HyperlinkButton Classes="projectLink"
                             NavigateUri="{Binding Website}"
                             ToolTip.Tip="{Binding Website}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
            </HyperlinkButton>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock Text="PdfOperations" FontSize="20" FontWeight="SemiBold" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="16" RowSpacing="8">
                <TextBlock Text="{Binding Loc.AboutVersionLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding Loc.AboutAuthorLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Author}" />
            </Grid>
            
            <Button Content="{Binding Loc.CheckUpdatesLabel}"
                    Command="{Binding CheckUpdatesCommand}" />
            <Button Content="{Binding Loc.DownloadUpdateLabel}" Command="{Binding DownloadUpdateCommand}" />
            <StackPanel IsVisible="{Binding IsDownloading}" Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Arc Width="24" Height="24" StartAngle="0" SweepAngle="270"
                         Stroke="{Binding StatusForeground}" StrokeThickness="3"
                         Classes.updating="{Binding IsDownloading}"
                         VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                        <Arc.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Arc.RenderTransform>
                    </Arc>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateActivityText}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding UpdateProgressText}" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                             Height="6" AutomationProperties.Name="{Binding UpdateProgressText}" />
                <Button Content="{Binding Loc.CancelUpdateDownload}" Command="{Binding CancelDownloadCommand}" />
            </StackPanel>
            
            <Button Content="{Binding Loc.RestartToUpdateLabel}"
                    Command="{Binding RestartToUpdateCommand}" />
            
            <Panel IsVisible="{Binding !IsDownloading}">
                <views:StatusBannerView IsVisible="{Binding IsStatusVisible}" />
            </Panel>

            <HyperlinkButton Classes="projectLink" IsVisible="{Binding HasUpdate}"
                             Content="{Binding Loc.OpenReleaseLabel}"
                             NavigateUri="{Binding ReleaseUrl}" />

            <HyperlinkButton Classes="projectLink"
                             NavigateUri="{Binding RepositoryUrl}"
                             ToolTip.Tip="{Binding RepositoryUrl}">
                <TextBlock Text="{Binding Loc.AboutRepositoryLabel}" TextWrapping="Wrap" />
            </HyperlinkButton>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Loc.AboutLibrariesLabel}" FontSize="18"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Libraries}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding Loc.AboutToolsLabel}" FontSize="18"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Tools}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Loc.AboutAiAssistanceLabel}" FontSize="18"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <HyperlinkButton Classes="projectLink"
                                 NavigateUri="{Binding CodexUrl}"
                                 ToolTip.Tip="{Binding CodexUrl}">
                    <TextBlock Text="{Binding Loc.AboutCodexCredit}" TextWrapping="Wrap" />
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
