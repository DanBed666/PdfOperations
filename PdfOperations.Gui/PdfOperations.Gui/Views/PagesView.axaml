<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             xmlns:views="clr-namespace:PdfOperations.Gui.Views"
             x:Class="PdfOperations.Gui.Views.PagesView"
             x:DataType="vm:PagesViewModel">

    <Grid RowDefinitions="Auto,*">
        <views:StatusBannerView Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="Input PDF files" />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="Browse"
                                Click="BrowseInputFiles_Click" />
                        <Button Content="Add"
                                Click="AddInputFiles_Click" />
                    </StackPanel>

                    <views:FileListView DataContext="{Binding InputFilesList}" />
                </StackPanel>
                
                <TextBlock Text="{Binding InputFilesInfo}"
                           TextWrapping="Wrap" />
                
                <TextBlock Text="Page mode" />

                <ComboBox ItemsSource="{Binding PageModes}"
                          SelectedItem="{Binding SelectedPageMode}" />

                <StackPanel IsVisible="{Binding IsCustomPagesMode}"
                            Spacing="8">
                    <TextBlock Text="Pages" />
                    <TextBox Text="{Binding Pages}"
                             Watermark="Example: 1,3-5" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSplitByPagesMode}"
                            Spacing="8">
                    <TextBlock Text="Split after pages" />
                    <TextBox Text="{Binding SplitAfterPages}"
                             Watermark="Example: 4,10,15" />
                </StackPanel>

                <TextBlock Text="Output directory" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="1"
                            Content="Browse"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <TextBlock Text="Output file name" />
                <TextBox Text="{Binding OutputFileName}"
                         IsEnabled="{Binding CanEditOutputFileName}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"
                            Width="120" />

                    <Button Content="Open output folder"
                            Command="{Binding OpenOutputFolderCommand}"
                            Width="170" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
