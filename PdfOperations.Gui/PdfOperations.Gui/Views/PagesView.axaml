<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             x:Class="PdfOperations.Gui.Views.PagesView"
             x:DataType="vm:PagesViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Text="Input PDF files" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding InputFilesText}"
                         IsReadOnly="True" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseInputFiles_Click" />
            </Grid>
            
            <TextBlock Text="{Binding InputFilesInfo}"
                       TextWrapping="Wrap" />

            <TextBlock Text="Pages" />
            <TextBox Text="{Binding Pages}"
                     Watermark="Example: 1,3-5" />

            <TextBlock Text="Output directory" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding OutputDirectory}" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Click="BrowseOutputDirectory_Click" />
            </Grid>

            <TextBlock Text="Output file name" />
            <TextBox Text="{Binding OutputFileName}"
                     IsEnabled="{Binding CanEditOutputFileName}" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Start"
                        Command="{Binding StartCommand}"
                        Width="120" />

                <Button Content="Open output folder"
                        Command="{Binding OpenOutputFolderCommand}"
                        Width="170" />
            </StackPanel>

            <Border Background="#F3F4F6"
                    Padding="10"
                    Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>