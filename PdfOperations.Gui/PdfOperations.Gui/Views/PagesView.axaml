<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfOperations.Gui.ViewModels"
             xmlns:views="clr-namespace:PdfOperations.Gui.Views"
             x:Class="PdfOperations.Gui.Views.PagesView"
             x:DataType="vm:PagesViewModel">

    <Grid RowDefinitions="Auto,*">
        <views:StatusBannerView Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding InputTitle}" />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="{Binding Loc.SelectFilesButton}"
                                Click="BrowseInputFiles_Click" />
                        <Button Content="{Binding Loc.AddFilesButton}"
                                IsEnabled="{Binding InputFilesList.HasFiles}"
                                Click="AddInputFiles_Click" />
                    </StackPanel>

                    <views:FileListView DataContext="{Binding InputFilesList}" />
                </StackPanel>
                
                <TextBlock Text="{Binding InputFilesInfo}"
                           TextWrapping="Wrap" />
                
                <TextBlock Text="{Binding Loc.PageMode}" />

                <ComboBox ItemsSource="{Binding PageModes}"
                          SelectedItem="{Binding SelectedPageMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel IsVisible="{Binding IsCustomPagesMode}"
                            Spacing="8">
                    <TextBlock Text="{Binding Loc.Pages}" />
                    <TextBox Text="{Binding Pages}"
                             PlaceholderText="{Binding Loc.ExamplePages}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSplitByPagesMode}"
                            Spacing="8">
                    <TextBlock Text="{Binding Loc.SplitAfterPages}" />
                    <TextBox Text="{Binding SplitAfterPages}"
                             PlaceholderText="{Binding Loc.ExampleSplitAfterPages}" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.OutputDirectory}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="1"
                            Content="{Binding Loc.Browse}"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <CheckBox Content="{Binding Loc.OverwriteExistingFiles}"
                          IsChecked="{Binding OverwriteExistingFiles}" />

                <TextBlock Text="{Binding Loc.OutputFileName}" />
                <TextBox Text="{Binding OutputFileName}"
                         IsEnabled="{Binding CanEditOutputFileName}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="{Binding Loc.Start}"
                            Classes="primary"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Width="120" />

                    <Button Content="{Binding Loc.OpenOutputFolder}"
                            Command="{Binding OpenOutputFolderCommand}"
                            Width="170" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
